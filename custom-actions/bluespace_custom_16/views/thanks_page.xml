<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template name="Thanks Order Page" t-name="order_thanks">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-3 col-xl-3"></div>
                            <div class="col-lg-7 col-xl-6 me-lg-auto">
                                <span class="d-block fa fa-4x fa-thumbs-up mx-auto rounded-circle bg-primary"/><br/>
                                <h1 class="text-center">Thank You!</h1>
                                <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                                    <hr class="mx-auto border-top w-50 border-dark text-center"/>
                                </div>
                                <h5 class="text-center" >
                                    <t t-if="is_checkout_page">
                                        Hi <span t-esc="partner_name"/><br/>
                                        <span class="fa fa-check-circle"/>
                                        <span>Thank you! Your account has been created successfully. We will get back to you shortly after the document verification. You can proceed with the payment once you get the account verification confirmation</span>
                                    </t>
                                    <t t-if="is_order_limit">
                                        Dear <span t-esc="partner_name"/>,
                                        <span>According to our records you are currently renting 3 units. Our credit risk policy limits customers to a maximum of 3 units. We have sent your request to the Manager to consider your request for another unit. If you would like to expedite the process, please call the Manager at 021 300 0645 or email info@bluespaces.co.za</span>
                                    </t>
                                </h5>
                            </div>
                            <div class="col-lg-1"></div>
                        </div>
                    </div>
                </section>
            </div>
            <input t-if='website.plausible_shared_key' type='hidden' class='js_plausible_push' data-event-name='Lead Generation' data-event-params='{"CTA": "Contact Us"}' />
        </t>
    </template>
</odoo>