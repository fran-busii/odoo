<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_order_renting_extended" model="ir.ui.view">
            <field name="name">sale.order.renting.extended</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_renting.rental_order_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position='after'>
                    <field name='is_recurring_rental' readonly="1" invisible="1"/>
                    <field name="existing_order"/> <!-- Added on 13-11-24 -->
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position='attributes'>
                    <attribute name="attrs"/>
                </xpath>
            </field>
        </record>

        <record id="product_template_website_description" model="ir.ui.view">
            <field name="name">product.template.website.description</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='general_information']//group[1]" position="after">
                    <group name="website_description" string="Website Description">
                        <field name="website_description" widget="html"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
