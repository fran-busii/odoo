<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.rental.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_renting.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@name='rental_delay_costs']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">
                            Unit Available After Days
                        </span>
                        <div class="text-muted" title="Those days are applied to consider the product available after payment not receive by EFT.">
                            If EFT payment not received then Unit available for booking after days
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="unit_days" string='Days' class="col-lg-3 o_light_label"/>
                                <field name="unit_days" class="col-lg-2 p-0"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">
                            Date Of Invoice
                        </span>
                        <div class="text-muted" title="Those values are applied to consider the next invoice.">
                            Next invoice day
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="date_of_invoice" string='Day' class="col-lg-3 o_light_label"/>
                                <field name="date_of_invoice" class="col-lg-2 p-0"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_setting_right_pane mt16">
                        <span class="o_form_label">
                            User Approval Email
                        </span>
                        <div class="text-muted" title="Those values are applied to consider the next invoice.">
                            User Approval Email 
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="user_email" string='Email' class="col-lg-3 o_light_label"/>
                                <field name="user_email" class="col-lg-2 p-0"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_setting_right_pane mt16">
                        <span class="o_form_label">
                            Sales Order Approval Email
                        </span>
                        <div class="text-muted" title="Send Email to salesperson.">
                            Sales Order Approval Email
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="salesperson_email" string='Salesperson Email' class="col-lg-3 o_light_label"/>
                                <field name="salesperson_email" class="col-lg-2 p-0"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_setting_right_pane mt16">
                        <span class="o_form_label">
                            Order Message for Office/Boardroom
                        </span>
                        <div class="text-muted" title="Those values are applied to consider the next invoice.">
                            Order Message for Office/Boardroom
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="order_message" string='Message' class="col-lg-3 o_light_label"/>
                                <field name="order_message" class="col-lg-2 p-0" style="margin-left: 17px;"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
