    <template id="rental_inherit_product" inherit_id="website_sale.product" name="Rental Product">
        <xpath expr="//a[@id='add_to_cart']" position="before">
            <t t-if="product.rent_ok and not (product.is_office or product.is_boardroom)">
                <div>
                    <h6 style="margin-bottom:0px;margin-right: 25px;" t-if="product.deposit_amount &gt; 0">
                        Deposit Amount:
                        <span t-esc="product.deposit_amount" style="white-space: nowrap;color:#188C1D;"
                            t-options="{'widget': 'monetary','display_currency': website.currency_id, }"/>
                    </h6>
                </div>
                <br/>
            </t>
        </xpath>

        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-set="categories" t-value="product.attribute_line_ids.filtered(lambda l: l.value_ids)"/>
            <t t-if="categories">
                <div class="pt32 pb32" id="product_full_spec">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="m-0">Specifications</h3>
                        </div>
                        <div id="product_specifications">
                            <div class="row">
                                <t t-foreach="categories" t-as="category">
                                    <div>
                                        <table class="table">
                                            <t t-if="len(categories) &gt; 1">
                                                <tr>
                                                    <th class="text-start" t-att-colspan="2">
                                                        <span t-if="category" t-field="category.attribute_id.name"/>
                                                        <span t-else="">Uncategorized</span>
                                                    </th>
                                                </tr>
                                            </t>
                                            <tr t-foreach="category.value_ids" t-as="value">
                                                <td class="w-25"><span t-field="category.attribute_id.name"/></td>
                                                <td class="w-75 text-muted">
                                                    <span t-field="value.name"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>


    <template id="cart_check_rental_prod_line" inherit_id="website_sale.cart_lines" name="Rental Product Cart Lines" priority="50" >
